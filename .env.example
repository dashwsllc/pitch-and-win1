# Values prefixed with VITE_ are shipped to the browser. Never place secret or
# service-role keys here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key

# Optional public Cloudflare Turnstile site key. The matching secret belongs in
# Supabase Auth > Bot and Abuse Protection, never in this file.
VITE_TURNSTILE_SITE_KEY=
